{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "baseBranchPatterns": [
        "main",
        "/^backplane-2\\.1[0-99]$/",
        "/^backplane-5\\.[0-9]+$/"
    ],
    "tekton": {
        "includePaths": [
            ".tekton/**"
        ],
        "schedule": [
            "at any time"
        ]
    },
    "packageRules": [
        {
            "matchManagers": [
                "dockerfile"
            ],
            "matchFileNames": [
                "mce-capi-webhook-config/Dockerfile"
            ],
            "enabled": true
        },
        {
            "matchBaseBranches": [
                "main",
                "/^backplane-2\\.1[0-99]$/",
                "/^backplane-5\\.[0-9]+$/"
            ],
            "matchManagers": [
                "tekton"
            ],
            "enabled": true,
            "addLabels": [
                "ok-to-test"
            ]
        },
        {
            "matchManagers": [
                "gomod"
            ],
            "enabled": false,
            "groupName": "go dependencies",
            "groupSlug": "go-deps"
        },
        {
            "matchManagers": [
                "gomod"
            ],
            "matchDepTypes": [
                "indirect"
            ],
            "enabled": false
        }
    ],
    "rebaseWhen": "behind-base-branch",
    "recreateWhen": "never",
    "addLabels": [
        "ok-to-test"
    ],
    "schedule": [
        "on monday"
    ]
}
